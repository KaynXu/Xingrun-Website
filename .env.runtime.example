XR_PROVIDER=deepseek
DEEPSEEK_API_KEY=your_deepseek_api_key
XR_DEEPSEEK_MODEL=deepseek-v4-pro

# Optional review-plan model override
# XR_REVIEW_PLAN_PROVIDER=deepseek
# XR_REVIEW_PLAN_MODEL=deepseek-v4-pro
# XR_REVIEW_PLAN_REASONING_EFFORT=
# XR_REVIEW_PLAN_TEMPERATURE=0.25
# XR_REVIEW_PLAN_WRITER_PROVIDER=deepseek
# XR_REVIEW_PLAN_WRITER_MODEL=deepseek-v4-pro
# XR_REVIEW_PLAN_WRITER_TEMPERATURE=0.35
# XR_REVIEW_PLAN_REPAIR_TEMPERATURE=0.1
# XR_REVIEW_PLAN_REVIEWER_TEMPERATURE=0.1

# Optional class-commentary teacher feedback override
# XR_CLASS_COMMENTARY_PROVIDER=openai
# XR_CLASS_COMMENTARY_MODEL=gpt-5.6-sol-0.3x
# XR_CLASS_COMMENTARY_OPENAI_BASE_URL=https://api.iiiiitoken.com/v1
# XR_CLASS_COMMENTARY_OPENAI_API_KEY=
# XR_CLASS_COMMENTARY_OPENAI_HEADERS='{"User-Agent":"Xingrun/1.0"}'
# XR_CLASS_COMMENTARY_MEMORY_ENABLED=0
# XR_CLASS_COMMENTARY_STRUCTURED_FEEDBACK_ENABLED=0
# XR_CLASS_COMMENTARY_STUDENT_MEMORY_V2_ENABLED=0
# XR_CLASS_COMMENTARY_STUDENT_GENERATION_TIMEOUT=300
# XR_CLASS_COMMENTARY_STUDENT_GENERATION_MAX_ATTEMPTS=3
# XR_REDIS_URL=redis://127.0.0.1:6379/0
# XR_CLASS_COMMENTARY_MEMORY_QUEUE=class_commentary_memory
# XR_MEM0_VECTOR_PROVIDER=qdrant
# XR_MEM0_QDRANT_URL=http://127.0.0.1:6333
# XR_MEM0_COLLECTION_NAME=xingrun_class_commentary_memory
# XR_MEM0_EMBEDDER_PROVIDER=openai
# XR_MEM0_EMBEDDER_MODEL=text-embedding-v4
# XR_MEM0_EMBEDDER_API_KEY=
# XR_MEM0_EMBEDDER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# XR_MEM0_EMBEDDING_DIMS=1024
# Supports legacy *.skill files, a colleagues/ directory, or the colleague-skill repo root.
# XR_COLLEAGUE_SKILL_DIR=/home/ubuntu/colleague-skill

# Optional review-plan Langfuse observability
# XR_REVIEW_PLAN_LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=pk-lf-your_langfuse_public_key
# LANGFUSE_SECRET_KEY=sk-lf-your_langfuse_secret_key
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# LANGFUSE_HOST=https://us.cloud.langfuse.com

# Optional admin override
# XR_ADMIN_USERNAME=admin
# XR_ADMIN_PASSWORD_HASH=<sha256_hex>
# XR_WECHAT_SERVICE_TOKEN=shared_secret_for_miniprogram_backend

# Optional alternate providers
# OPENAI_API_KEY=
# XR_OPENAI_MODEL=gpt-4o
# XR_OPENAI_BASE_URL=
# DASHSCOPE_API_KEY=your_dashscope_api_key
# XR_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# XR_VISION_PROVIDER=qwen
# XR_VISION_MODEL=qwen-vl-max-latest

# Optional audio transcription provider
# XR_AUDIO_TRANSCRIPTION_PROVIDER=local
# XR_AUDIO_TRANSCRIPTION_PROVIDER=tencent
# TENCENTCLOUD_APP_ID=your_tencentcloud_app_id
# TENCENTCLOUD_SECRET_ID=your_tencentcloud_secret_id
# TENCENTCLOUD_SECRET_KEY=your_tencentcloud_secret_key
# XR_TENCENT_ASR_ENGINE_TYPE=16k_zh

XR_PROVIDER=deepseek
DEEPSEEK_API_KEY=your_deepseek_api_key
XR_DEEPSEEK_MODEL=deepseek-v4-pro

# Optional review-plan model override
# XR_REVIEW_PLAN_PROVIDER=deepseek
# XR_REVIEW_PLAN_MODEL=deepseek-v4-pro
# XR_REVIEW_PLAN_WRITER_PROVIDER=deepseek
# XR_REVIEW_PLAN_WRITER_MODEL=deepseek-v4-pro

# Optional admin override
# XR_ADMIN_USERNAME=admin
# XR_ADMIN_PASSWORD_HASH=<sha256_hex>
# XR_WECHAT_SERVICE_TOKEN=shared_secret_for_miniprogram_backend

# Optional alternate providers
# OPENAI_API_KEY=
# XR_OPENAI_MODEL=gpt-4o
# XR_OPENAI_BASE_URL=
# DASHSCOPE_API_KEY=your_dashscope_api_key
# XR_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# XR_VISION_PROVIDER=qwen
# XR_VISION_MODEL=qwen-vl-max-latest

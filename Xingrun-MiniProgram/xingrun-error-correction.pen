          "layout": "vertical",
          "gap": 14,
          "padding": 16,
          "cornerRadius": 24,
          "fill": "#111827",
          "width": "fill_container",
          "children": [
            {
              "id": "cropProgress",
              "type": "frame",
              "layout": "horizontal",
              "justifyContent": "space_between",
              "alignItems": "center",
              "width": "fill_container",
              "children": [
                {
                  "id": "cropProgressText",
                  "type": "text",
                  "content": "2 / 5",
                  "fontFamily": "PingFang SC",
                  "fontSize": 13,
                  "fontWeight": "600",
                  "fill": "#FFFFFF"
                },
                {
                  "id": "cropProgressHint",
                  "type": "text",
                  "content": "当前是第 2 张，最后一张会变为“裁剪并上传”",
                  "fontFamily": "PingFang SC",
                  "fontSize": 12,
                  "fontWeight": "normal",
                  "fill": "#94A3B8"
                }
              ]
            },
            {
              "id": "cropButtons",
              "type": "frame",
              "layout": "horizontal",
              "gap": 10,
              "width": "fill_container",
              "children": [
                {
                  "id": "cropButtonLight",
                  "type": "frame",
                  "layout": "horizontal",
                  "justifyContent": "center",
                  "alignItems": "center",
                  "padding": [16, 12],
                  "cornerRadius": 16,
                  "fill": "#F2F2F2",
                  "width": "fill_container",
                  "children": [
                    {
                      "id": "cropButtonLightText",
                      "type": "text",
                      "content": "使用原图",
                      "fontFamily": "PingFang SC",
                      "fontSize": 15,
                      "fontWeight": "600",
                      "fill": "#111111"
                    }
                  ]
                },
                {
                  "id": "cropButtonPrimary",
                  "type": "frame",
                  "layout": "horizontal",
                  "justifyContent": "center",
                  "alignItems": "center",
                  "padding": [16, 12],
                  "cornerRadius": 16,
                  "fill": "#07C160",
                  "width": "fill_container",
                  "children": [
                    {
                      "id": "cropButtonPrimaryText",
                      "type": "text",
                      "content": "裁剪并继续",
                      "fontFamily": "PingFang SC",
                      "fontSize": 15,
                      "fontWeight": "600",
                      "fill": "#FFFFFF"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}

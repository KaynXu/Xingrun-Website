.wrongbook-page {
  min-height: 100vh;
  padding: 28rpx;
  background: linear-gradient(180deg, #f6fbff 0%, #eef6ff 100%);
  box-sizing: border-box;
}

.state-card {
  margin-bottom: 24rpx;
  padding: 30rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 48rpx rgba(45, 87, 140, 0.08);
}

.state-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #10233f;
}

.state-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #60738f;
}

.error-card {
  border: 2rpx solid rgba(214, 68, 68, 0.12);
  background: #fff5f5;
}

.item-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.item-card {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 32rpx rgba(45, 87, 140, 0.07);
}

.item-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #eef6ff;
}

.item-body {
  flex: 1;
  min-width: 0;
}

.item-top {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.error-tag {
  background: #e9f5ff;
  color: #2375d8;
}

.mastered-tag {
  background: #e8faf0;
  color: #1d8348;
}

.item-summary {
  display: block;
  font-size: 26rpx;
  color: #2c3e50;
  line-height: 1.6;
  margin-bottom: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.item-date {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
}

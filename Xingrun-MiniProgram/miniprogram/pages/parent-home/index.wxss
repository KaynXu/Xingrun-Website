.parent-page {
  min-height: 100vh;
  padding: 28rpx;
  background: linear-gradient(180deg, #f6fbff 0%, #eef6ff 100%);
  box-sizing: border-box;
}

.hero-card,
.state-card,
.binding-card {
  margin-bottom: 24rpx;
  padding: 30rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 48rpx rgba(45, 87, 140, 0.08);
}

.hero-badge {
  display: inline-block;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #e9f5ff;
  color: #2375d8;
  font-size: 22rpx;
  font-weight: 600;
}

.hero-title,
.panel-title,
.state-title,
.binding-name {
  display: block;
  color: #10233f;
}

.hero-title {
  margin-top: 18rpx;
  font-size: 40rpx;
  font-weight: 700;
}

.hero-subtitle,
.state-desc,
.binding-meta {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #60738f;
}

.panel-head,
.binding-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.panel-title,
.state-title,
.binding-name {
  font-size: 30rpx;
  font-weight: 600;
}

.binding-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.primary-btn,
.ghost-btn {
  border-radius: 22rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.primary-btn {
  background: #2375d8;
  color: #ffffff;
}

.ghost-btn {
  margin-top: 0;
  background: #eef5ff;
  color: #2375d8;
}

.primary-btn::after,
.ghost-btn::after {
  border: none;
}

.mini-btn {
  margin-top: 0;
  padding: 0 24rpx;
  line-height: 72rpx;
  font-size: 24rpx;
}

.error-card {
  border: 2rpx solid rgba(214, 68, 68, 0.12);
  background: #fff5f5;
}

.binding-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex-shrink: 0;
}

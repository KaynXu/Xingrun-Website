.invite-panel {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.field-group {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.field-help {
  display: block;
  font-size: 24rpx;
  line-height: 1.6;
  color: #60738f;
  word-break: break-all;
}

.field-input {
  width: 100%;
  min-height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  border-radius: 22rpx;
  background: #f5f9ff;
  font-size: 28rpx;
  color: #10233f;
  box-sizing: border-box;
}

.lookup-btn {
  width: 100%;
  margin-top: 0;
  white-space: nowrap;
  box-sizing: border-box;
}

.mini-btn {
  width: 100%;
  margin-top: 0;
  padding: 0 24rpx;
  line-height: 72rpx;
  font-size: 24rpx;
  white-space: nowrap;
  box-sizing: border-box;
}

.section-head,
.student-card {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: space-between;
  gap: 20rpx;
}

.section-head .ghost-btn {
  width: 100%;
  margin-top: 0;
  box-sizing: border-box;
}

.binding-list,
.student-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 18rpx;
}

.bound-child-card,
.student-card {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: #f5f9ff;
  border: 2rpx solid rgba(35, 117, 216, 0.08);
  box-sizing: border-box;
}

.class-result {
  display: flex;
  flex-direction: column;
}

.class-result-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #10233f;
}

.student-info {
  min-width: 0;
}

.bound-child-name,
.bound-child-meta,
.class-result-title,
.student-name,
.student-meta {
  word-break: break-all;
}

.empty-student-card {
  margin-top: 18rpx;
  margin-bottom: 0;
  background: #f8fbff;
}

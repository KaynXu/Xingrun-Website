.parent-page {
  min-height: 100vh;
  padding: 28rpx;
  background: linear-gradient(180deg, #f7fbff 0%, #edf5ff 100%);
  box-sizing: border-box;
}

.hero-card,
.panel-card,
.state-card {
  margin-bottom: 24rpx;
  padding: 30rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 48rpx rgba(45, 87, 140, 0.08);
}

.hero-badge {
  display: inline-block;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #e9f5ff;
  color: #2375d8;
  font-size: 22rpx;
  font-weight: 600;
}

.hero-title {
  display: block;
  margin-top: 18rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #10233f;
}

.hero-subtitle,
.section-subtitle,
.student-meta,
.state-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #60738f;
}

.field-label,
.section-title,
.state-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #10233f;
}

.field-input {
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: #f5f9ff;
  font-size: 28rpx;
  color: #10233f;
}

.primary-btn,
.ghost-btn {
  margin-top: 22rpx;
  border-radius: 22rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.primary-btn {
  background: #2375d8;
  color: #ffffff;
}

.primary-btn::after,
.ghost-btn::after {
  border: none;
}

.ghost-btn {
  margin-top: 0;
  background: #eef5ff;
  color: #2375d8;
}

.mini-btn {
  margin-top: 0;
  padding: 0 24rpx;
  line-height: 72rpx;
  font-size: 24rpx;
}

.section-head,
.student-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.binding-list,
.student-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 18rpx;
}

.binding-chip,
.student-card {
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: #f5f9ff;
}

.student-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #10233f;
}

.error-card {
  border: 2rpx solid rgba(214, 68, 68, 0.12);
  background: #fff5f5;
}

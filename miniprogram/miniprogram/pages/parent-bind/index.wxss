.field-input {
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: #f5f9ff;
  font-size: 28rpx;
  color: #10233f;
}

.mini-btn {
  width: 100%;
  margin-top: 0;
  padding: 0 24rpx;
  line-height: 72rpx;
  font-size: 24rpx;
  white-space: nowrap;
  box-sizing: border-box;
}

.section-head,
.student-card {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: space-between;
  gap: 20rpx;
}

.section-head .ghost-btn {
  width: 100%;
  margin-top: 0;
  box-sizing: border-box;
}

.binding-list,
.student-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 18rpx;
}

.binding-chip,
.student-card {
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: #f5f9ff;
}

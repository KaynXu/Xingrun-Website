.panel-head,
.binding-card {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: space-between;
  gap: 20rpx;
}

.binding-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.panel-copy,
.binding-info {
  min-width: 0;
}

.panel-desc,
.binding-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #60738f;
  word-break: break-all;
}

.empty-card {
  border: 2rpx solid rgba(35, 117, 216, 0.12);
  background: #f8fbff;
}

.binding-meta-stack {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-top: 12rpx;
}

.binding-name,
.binding-meta,
.binding-hint {
  word-break: break-all;
}

.mini-btn {
  width: 100%;
  margin-top: 0;
  padding: 0 24rpx;
  line-height: 72rpx;
  font-size: 24rpx;
  white-space: nowrap;
  box-sizing: border-box;
}

.binding-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  width: 100%;
  flex-shrink: 0;
}

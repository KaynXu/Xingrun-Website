.panel-head,
.binding-card {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: space-between;
  gap: 20rpx;
}

.binding-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.mini-btn {
  width: 100%;
  margin-top: 0;
  padding: 0 24rpx;
  line-height: 72rpx;
  font-size: 24rpx;
  white-space: nowrap;
  box-sizing: border-box;
}

.binding-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  width: 100%;
  flex-shrink: 0;
}

.panel-head {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: space-between;
  gap: 20rpx;
}

.binding-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 22rpx 24rpx;
}

.binding-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.panel-copy,
.binding-info {
  min-width: 0;
}

.binding-info {
  flex: 1;
}

.binding-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.current-binding-tag {
  flex: 0 0 auto;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  background: #e8faf0;
  color: #178b4f;
  font-size: 20rpx;
  line-height: 1.3;
}

.panel-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #60738f;
  word-break: break-all;
}

.empty-card {
  border: 2rpx solid rgba(35, 117, 216, 0.12);
  background: #f8fbff;
}

.binding-name,
.binding-meta {
  word-break: break-all;
}

.binding-name {
  min-width: 0;
}

.binding-meta {
  margin-top: 10rpx;
}

.mini-btn {
  min-width: 160rpx;
  margin-top: 0;
  padding: 0 18rpx;
  line-height: 64rpx;
  font-size: 23rpx;
  white-space: nowrap;
  box-sizing: border-box;
}

.binding-actions {
  display: flex;
  flex-direction: column;
  flex: 0 0 auto;
  gap: 10rpx;
  align-items: flex-end;
}

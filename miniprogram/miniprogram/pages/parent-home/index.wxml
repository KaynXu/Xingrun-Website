<view class="parent-page">
  <view class="hero-card">
    <text class="hero-badge">家长主页</text>
    <text class="hero-title">上传入口只保留最需要的三步</text>
    <text class="hero-subtitle">先选孩子，再拍照上传，老师就能在网站错题工作区里看到这条记录。</text>
  </view>

  <view wx:if="{{loading}}" class="state-card">
    <text class="state-title">正在同步绑定关系</text>
    <text class="state-desc">把当前微信号下已绑定的孩子整理出来。</text>
  </view>

  <view wx:elif="{{errorMessage}}" class="state-card error-card">
    <text class="state-title">家长主页暂时打不开</text>
    <text class="state-desc">{{errorMessage}}</text>
  </view>

  <view wx:elif="{{!bindings.length}}" class="state-card">
    <text class="state-title">还没有绑定孩子</text>
    <text class="state-desc">先输入老师发来的班级邀请码，再从网站学生名单中选择孩子。</text>
    <button class="primary-btn" bindtap="goBindMore">去绑定孩子</button>
  </view>

  <view wx:else class="binding-list">
    <text class="panel-title">选择孩子上传</text>

    <view wx:for="{{bindings}}" wx:key="id" class="binding-card">
      <view>
        <text class="binding-name">{{item.studentName || '未命名学生'}}</text>
        <text class="binding-meta">{{item.className || '未命名班级'}}</text>
      </view>
      <view class="binding-actions">
        <button class="ghost-btn mini-btn" data-student-id="{{item.studentId}}" data-student-name="{{item.studentName}}" bindtap="goWrongbook">查看错题本</button>
        <button class="primary-btn mini-btn" data-binding-id="{{item.id}}" bindtap="goUpload">上传错题</button>
      </view>
    </view>
  </view>
</view>

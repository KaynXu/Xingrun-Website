.wrongbook-hero {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  background: linear-gradient(135deg, #ffffff 0%, #eef7ff 100%);
}

.hero-stat-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 4rpx;
}

.hero-stat-pill {
  flex: 1;
  min-width: 190rpx;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: inset 0 0 0 1rpx rgba(35, 117, 216, 0.08);
}

.hero-stat-value,
.hero-stat-label {
  display: block;
}

.hero-stat-value {
  font-size: 30rpx;
  font-weight: 700;
  color: #10233f;
  word-break: break-all;
}

.hero-stat-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #60738f;
}

.library-card {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f0f7ff 100%);
  box-shadow: 0 16rpx 48rpx rgba(45, 87, 140, 0.08);
}

.upload-status-card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  border: 2rpx solid rgba(35, 117, 216, 0.1);
  background: #f4f9ff;
  box-shadow: 0 16rpx 48rpx rgba(45, 87, 140, 0.08);
}

.upload-status-error {
  border-color: rgba(214, 68, 68, 0.12);
  background: #fff5f5;
}

.upload-status-title,
.upload-status-desc {
  display: block;
}

.upload-status-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #10233f;
}

.upload-status-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #60738f;
}

.library-copy {
  flex: 1;
  min-width: 0;
}

.library-state-tag {
  display: inline-block;
  margin-bottom: 12rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.library-state-ready {
  background: #e8faf0;
  color: #1d8348;
}

.library-state-pending {
  background: #fff7e6;
  color: #ad6800;
}

.library-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #10233f;
}

.library-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #60738f;
}

.library-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.library-btn {
  width: 100%;
  margin: 0;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
  box-sizing: border-box;
  flex-shrink: 0;
}

.library-btn-pending {
  background: #eef5ff;
  color: #2375d8;
}

.state-card {
  margin-bottom: 24rpx;
  padding: 30rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 48rpx rgba(45, 87, 140, 0.08);
}

.state-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #10233f;
}

.state-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #60738f;
}

.error-card {
  border: 2rpx solid rgba(214, 68, 68, 0.12);
  background: #fff5f5;
}

.empty-card,
.loading-card {
  background: #f8fbff;
}

.state-action-btn {
  width: 100%;
  margin-top: 22rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  white-space: nowrap;
}

.item-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.filter-panel {
  padding: 24rpx;
}

.filter-head {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 18rpx;
}

.filter-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #10233f;
}

.filter-desc {
  display: block;
  font-size: 22rpx;
  line-height: 1.6;
  color: #60738f;
}

.topic-scroll {
  white-space: nowrap;
}

.topic-chip {
  display: inline-block;
  margin: 0 12rpx 12rpx 0;
  padding: 0 22rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #2375d8;
  font-size: 22rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 20rpx rgba(45, 87, 140, 0.08);
}

.topic-chip-active {
  background: #2375d8;
  color: #ffffff;
}

.item-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 18rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 32rpx rgba(45, 87, 140, 0.07);
}

.item-card-head {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  width: 100%;
}

.item-media {
  width: 100%;
  overflow: hidden;
  border-radius: 18rpx;
  background: #eef6ff;
}

.item-img {
  display: block;
  width: 100%;
  height: 220rpx;
}

.item-body {
  width: 100%;
  flex: 1;
  min-width: 0;
}

.item-top {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.error-tag {
  background: #e9f5ff;
  color: #2375d8;
}

.topic-tag {
  background: #f3f8ff;
  color: #1f5f99;
}

.mastered-tag {
  background: #e8faf0;
  color: #1d8348;
}

.pending-tag {
  background: #fff7e6;
  color: #ad6800;
}

.failed-tag {
  background: #fff1f0;
  color: #c0392b;
}

.item-status-card {
  display: block;
  margin-bottom: 10rpx;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: #fff7e6;
  font-size: 24rpx;
  line-height: 1.6;
  color: #ad6800;
  white-space: pre-wrap;
  word-break: break-all;
}

.item-section {
  min-width: 0;
  margin-bottom: 12rpx;
}

.item-section-label {
  display: block;
  margin-bottom: 6rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: #7b8da6;
  letter-spacing: 0;
}

.item-summary {
  display: block;
  font-size: 26rpx;
  color: #2c3e50;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
}

.item-question {
  display: block;
  font-size: 26rpx;
  line-height: 1.6;
  color: #10233f;
  white-space: pre-wrap;
  word-break: break-all;
}

.edit-topic-btn {
  display: inline-block;
  width: auto;
  min-width: 0;
  margin: 0 0 10rpx;
  padding: 0 20rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 999rpx;
  background: #eef6ff;
  color: #2375d8;
  font-size: 22rpx;
  font-weight: 600;
}

.edit-topic-btn::after,
.topic-chip::after,
.topic-action-btn::after {
  border: none;
}

.topic-edit-card {
  margin: 0 0 12rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #f6f9ff;
}

.topic-picker,
.topic-input {
  width: 100%;
  min-height: 68rpx;
  line-height: 68rpx;
  padding: 0 18rpx;
  border-radius: 16rpx;
  background: #ffffff;
  color: #10233f;
  font-size: 24rpx;
  box-sizing: border-box;
}

.topic-input {
  margin-top: 12rpx;
}

.topic-edit-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
}

.topic-action-btn {
  flex: 1;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 999rpx;
  background: #e9f1fb;
  color: #334155;
  font-size: 22rpx;
  font-weight: 600;
}

.topic-save-btn {
  margin-top: 0;
}

.item-date {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
}

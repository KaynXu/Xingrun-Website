.wrongbook-page {
  min-height: 100vh;
  padding: 28rpx;
  background: linear-gradient(180deg, #f6fbff 0%, #eef6ff 100%);
  box-sizing: border-box;
}

.library-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f0f7ff 100%);
  box-shadow: 0 16rpx 48rpx rgba(45, 87, 140, 0.08);
}

.library-copy {
  flex: 1;
  min-width: 0;
}

.library-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #10233f;
}

.library-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #60738f;
}

.library-btn {
  margin: 0;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  background: #2375d8;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.state-card {
  margin-bottom: 24rpx;
  padding: 30rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 48rpx rgba(45, 87, 140, 0.08);
}

.state-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #10233f;
}

.state-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #60738f;
}

.error-card {
  border: 2rpx solid rgba(214, 68, 68, 0.12);
  background: #fff5f5;
}

.item-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.topic-scroll {
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.topic-chip {
  display: inline-block;
  margin: 0 12rpx 12rpx 0;
  padding: 0 22rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #2375d8;
  font-size: 22rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 20rpx rgba(45, 87, 140, 0.08);
}

.topic-chip-active {
  background: #2375d8;
  color: #ffffff;
}

.item-card {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 32rpx rgba(45, 87, 140, 0.07);
}

.item-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #eef6ff;
}

.item-body {
  flex: 1;
  min-width: 0;
}

.item-top {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.error-tag {
  background: #e9f5ff;
  color: #2375d8;
}

.topic-tag {
  background: #f3f8ff;
  color: #1f5f99;
}

.mastered-tag {
  background: #e8faf0;
  color: #1d8348;
}

.item-summary {
  display: block;
  font-size: 26rpx;
  color: #2c3e50;
  line-height: 1.6;
  margin-bottom: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.item-question {
  display: block;
  margin-bottom: 10rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #10233f;
  white-space: pre-wrap;
  word-break: break-all;
}

.edit-topic-btn {
  display: inline-block;
  width: auto;
  min-width: 0;
  margin: 0 0 10rpx;
  padding: 0 20rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 999rpx;
  background: #eef6ff;
  color: #2375d8;
  font-size: 22rpx;
  font-weight: 600;
}

.edit-topic-btn::after,
.topic-chip::after,
.topic-action-btn::after {
  border: none;
}

.topic-edit-card {
  margin: 0 0 12rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #f6f9ff;
}

.topic-picker,
.topic-input {
  width: 100%;
  min-height: 68rpx;
  line-height: 68rpx;
  padding: 0 18rpx;
  border-radius: 16rpx;
  background: #ffffff;
  color: #10233f;
  font-size: 24rpx;
  box-sizing: border-box;
}

.topic-input {
  margin-top: 12rpx;
}

.topic-edit-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
}

.topic-action-btn {
  flex: 1;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 999rpx;
  background: #e9f1fb;
  color: #334155;
  font-size: 22rpx;
  font-weight: 600;
}

.topic-save-btn {
  background: #2375d8;
  color: #ffffff;
}

.item-date {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
}

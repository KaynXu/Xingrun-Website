.parent-page {
  min-height: 100vh;
  padding: 28rpx;
  background: linear-gradient(180deg, #f8fbff 0%, #eef5ff 100%);
  box-sizing: border-box;
}

.hero-card,
.panel-card,
.state-card {
  margin-bottom: 24rpx;
  padding: 30rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 48rpx rgba(45, 87, 140, 0.08);
}

.hero-badge {
  display: inline-block;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #e9f5ff;
  color: #2375d8;
  font-size: 22rpx;
  font-weight: 600;
}

.hero-title,
.field-label,
.state-title {
  display: block;
  color: #10233f;
}

.hero-title {
  margin-top: 18rpx;
  font-size: 40rpx;
  font-weight: 700;
}

.hero-subtitle,
.state-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #60738f;
}

.field-label {
  font-size: 28rpx;
  font-weight: 600;
}

.topic-label {
  margin-bottom: 14rpx;
}

.topic-picker,
.field-input {
  width: 100%;
  min-height: 76rpx;
  line-height: 76rpx;
  padding: 0 22rpx;
  border-radius: 18rpx;
  background: #f6f9ff;
  color: #10233f;
  font-size: 26rpx;
  box-sizing: border-box;
}

.topic-input {
  margin-top: 12rpx;
  margin-bottom: 24rpx;
}

.mode-switch-row {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.mode-btn {
  flex: 1;
  border-radius: 22rpx;
  background: #eef5ff;
  color: #2375d8;
  font-size: 26rpx;
  font-weight: 600;
}

.mode-btn-active {
  background: #2375d8;
  color: #ffffff;
}

.mode-btn::after {
  border: none;
}

.thumb-strip {
  margin-top: 18rpx;
  white-space: nowrap;
}

.thumb-item {
  position: relative;
  display: inline-block;
  width: 116rpx;
  height: 116rpx;
  margin-right: 12rpx;
  border-radius: 20rpx;
  overflow: hidden;
  border: 3rpx solid transparent;
  box-sizing: border-box;
  background: #eef5ff;
}

.thumb-item-active {
  border-color: #2375d8;
}

.thumb-image {
  width: 100%;
  height: 100%;
}

.crop-stage-shell {
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 32rpx;
  background: #172036;
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.18);
}

.crop-stage {
  position: relative;
  margin: 0 auto;
  border-radius: 28rpx;
  overflow: hidden;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.92), rgba(226, 232, 240, 0.98)),
    repeating-linear-gradient(
      45deg,
      rgba(148, 163, 184, 0.12) 0 18rpx,
      rgba(255, 255, 255, 0.16) 18rpx 36rpx
    );
}

.crop-image {
  position: absolute;
  display: block;
}

.crop-status {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  text-align: center;
  background: rgba(241, 245, 249, 0.94);
  pointer-events: none;
}

.crop-status-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
}

.crop-status-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #475467;
}

.crop-box {
  position: absolute;
  border: 3rpx solid rgba(35, 117, 216, 0.72);
  background: rgba(35, 117, 216, 0.12);
  box-sizing: border-box;
}

.crop-box-active {
  border-color: #ffffff;
  background: rgba(35, 117, 216, 0.2);
}

.crop-box-label {
  position: absolute;
  top: 8rpx;
  left: 10rpx;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(15, 23, 42, 0.72);
  color: #ffffff;
  font-size: 20rpx;
}

.corner {
  position: absolute;
  width: 34rpx;
  height: 34rpx;
  background: transparent;
  box-sizing: border-box;
}

.corner-nw {
  top: -4rpx;
  left: -4rpx;
  border-top: 6rpx solid #ffffff;
  border-left: 6rpx solid #ffffff;
}

.corner-ne {
  top: -4rpx;
  right: -4rpx;
  border-top: 6rpx solid #ffffff;
  border-right: 6rpx solid #ffffff;
}

.corner-sw {
  bottom: -4rpx;
  left: -4rpx;
  border-bottom: 6rpx solid #ffffff;
  border-left: 6rpx solid #ffffff;
}

.corner-se {
  bottom: -4rpx;
  right: -4rpx;
  border-bottom: 6rpx solid #ffffff;
  border-right: 6rpx solid #ffffff;
}

.crop-grid {
  position: absolute;
  background: rgba(255, 255, 255, 0.38);
}

.crop-grid-v1,
.crop-grid-v2 {
  top: 0;
  bottom: 0;
  width: 1rpx;
}

.crop-grid-v1 {
  left: 33.333%;
}

.crop-grid-v2 {
  left: 66.666%;
}

.crop-grid-h1,
.crop-grid-h2 {
  left: 0;
  right: 0;
  height: 1rpx;
}

.crop-grid-h1 {
  top: 33.333%;
}

.crop-grid-h2 {
  top: 66.666%;
}

.status-hint {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #dbe7ff;
}

.action-row {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
  margin-top: 18rpx;
}

.primary-btn,
.ghost-btn {
  margin-top: 22rpx;
  border-radius: 22rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.picker-btn {
  width: 100%;
  padding: 0 24rpx;
  line-height: 84rpx;
  white-space: nowrap;
  box-sizing: border-box;
}

.submit-btn {
  width: 100%;
  padding: 0 24rpx;
  line-height: 84rpx;
  white-space: nowrap;
  box-sizing: border-box;
}

.compact-btn {
  flex: 1;
  margin-top: 0;
  min-width: 0;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 12rpx;
  font-size: 24rpx;
  white-space: nowrap;
  box-sizing: border-box;
}

.primary-btn {
  background: #2375d8;
  color: #ffffff;
}

.ghost-btn {
  background: #eef5ff;
  color: #2375d8;
}

.primary-btn::after,
.ghost-btn::after {
  border: none;
}

.textarea-label {
  margin-top: 24rpx;
}

.field-textarea {
  width: 100%;
  min-height: 220rpx;
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  background: #f5f9ff;
  font-size: 28rpx;
  color: #10233f;
}

.voice-card {
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: #f5f9ff;
}

.voice-btn {
  margin-top: 0;
}

.voice-status,
.voice-hint {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #60738f;
}

.upload-stage {
  margin-top: 22rpx;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  border: 2rpx solid rgba(35, 117, 216, 0.1);
  background: #f4f9ff;
}

.upload-stage-error {
  border-color: rgba(214, 68, 68, 0.12);
  background: #fff5f5;
}

.upload-stage-title,
.upload-stage-desc {
  display: block;
}

.upload-stage-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #10233f;
}

.upload-stage-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #60738f;
}

.state-title {
  font-size: 30rpx;
  font-weight: 600;
}

.error-card {
  border: 2rpx solid rgba(214, 68, 68, 0.12);
  background: #fff5f5;
}

.success-card {
  border: 2rpx solid rgba(35, 117, 216, 0.1);
  background: #f4f9ff;
}

.hidden-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  opacity: 0;
  pointer-events: none;
}
